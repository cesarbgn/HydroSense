# Copiar a .env (no se sube a Git). Los valores son solo de ejemplo.

# Base de datos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hydrosense
DB_PASSWORD=cambia_esto
DB_NAME=hydrosense
# Solo la usan el contenedor de MariaDB y las pruebas (crean BD temporales).
DB_ROOT_PASSWORD=cambia_esto_tambien

# MQTT
MQTT_URL=mqtt://127.0.0.1:1883

# API
PORT=3000
JWT_SECRET=genera_una_cadena_aleatoria_de_al_menos_32_caracteres
CORS_ORIGIN=http://localhost:8443
TZ=America/Mexico_City

# Correo (en desarrollo: Mailpit, con `docker compose --profile correo`)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=alertas@hydrosense.local

# Respuesta automática: torreta y sirena al crear una alerta
ACTUADORES_AUTO=true

# Contraseñas de los usuarios demo (apps/backend/scripts/seed.js)
SEED_PASSWORD_GERENCIA=cambia_esto_gerencia
SEED_PASSWORD_MANTENIMIENTO=cambia_esto_mantenimiento
